# Clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Bot Telegram (@BotFather sur Telegram)
TELEGRAM_TOKEN=1234567890:AAG...

# Ton chat ID Telegram (@userinfobot pour le trouver)
TELEGRAM_ADMIN_ID=123456789

# Clé privée de ton wallet Solana (base58)
WALLET_PRIVATE_KEY=

# RPC Solana (optionnel - défaut: mainnet public)
# Recommandé: https://rpc.helius.xyz/?api-key=... ou https://solana-mainnet.g.alchemy.com/v2/...
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Montant max par trade en SOL (ex: 0.1 = 0.1 SOL par position)
MAX_POSITION_SOL=0.1

# Stop Loss / Take Profit par défaut (peut être surchargé par le Risk Manager IA)
DEFAULT_STOP_LOSS_PCT=20
DEFAULT_TAKE_PROFIT_PCT=50

# Filtres du scanner
MIN_LIQUIDITY_USD=10000
MIN_VOLUME_24H_USD=50000
MIN_MARKET_CAP_USD=100000
MAX_TOKEN_AGE_HOURS=72
MIN_TOKEN_AGE_HOURS=1    # Ignore les tokens < 1h (pas assez de données)

# Birdeye API (optionnel — sécurité on-chain: mint authority, holders)
# Clé gratuite: https://bds.birdeye.so (30K compute units/mois)
BIRDEYE_API_KEY=
